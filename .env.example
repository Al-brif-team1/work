# Шаблон конфигурации. Скопируйте нужные строки в собственный .env.
#
# Обязательны только три первые переменные. У остальных есть значения по умолчанию
# в app/config/settings.py — переносите их в .env лишь когда меняете значение,
# иначе дефолт окажется записан дважды и .env будет перекрывать код.
#
# Пустое значение не означает «по умолчанию»: строка вида LLM_MAX_TOKENS= не пройдет
# валидацию и приложение не запустится. Чтобы остаться на дефолте, не пишите строку.

# --- Провайдер LLM (обязательно) ---
# Подходит любой OpenAI-совместимый API, адрес задается явно.
LLM_API_KEY=your_key
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Параметры генерации ---
# LLM_TEMPERATURE  насколько случаен выбор слова, от 0 до 2   (по умолчанию 0.0)
#
# LLM_MAX_TOKENS   ДЛИНА ответа                               (по умолчанию не задан)
#                  Жесткий предел: дойдя до него, модель обрывает ответ на
#                  полуслове. Короче писать она не начинает, ее просто прерывают.
#                  Все этапы просят JSON, поэтому обрыв дает сломанный JSON и
#                  запрос падает с ошибкой. Ставьте с запасом: это страховка от
#                  лишних трат, а не способ управлять стилем.
#
# LLM_TOP_P        ВЫБОР слова, на длину не влияет            (по умолчанию не задан)
#                  Модель выстраивает возможные следующие слова от самого
#                  вероятного к самому редкому. Значение 0.9 означает: бери
#                  варианты с начала списка, пока их суммарная вероятность не
#                  наберет 90%, а редкий хвост отбрось. Чем меньше значение, тем
#                  суше текст; 1.0 не отбрасывает ничего.
#                  Управляет тем же, чем LLM_TEMPERATURE, поэтому менять принято
#                  что-то одно. При LLM_TEMPERATURE=0.0 не влияет почти ни на что.
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=512
# LLM_TOP_P=0.9

# --- Надежность вызовов ---
# LLM_MAX_ATTEMPTS       ОБЩЕЕ число попыток, а не число повторов:
#                        при 2 уходит два запроса, а не три       (по умолчанию 2)
# LLM_TIMEOUT_SECONDS    таймаут одной попытки                    (по умолчанию 60.0)
# LLM_TRANSPORT_RETRIES  повторы внутри SDK openai, поверх наших попыток.
#                        При 0 за повторы отвечает один слой и таймаут считается
#                        честно; при 2 один неудачный вызов может обернуться
#                        шестью запросами к провайдеру            (по умолчанию 0)
# LLM_MAX_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=60.0
# LLM_TRANSPORT_RETRIES=0

# --- Трассировка Langfuse ---
# Без пары ключей трассировка отключается и используется заглушка.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Приложение ---
DEBUG=false
LOG_LEVEL=INFO

# --- База знаний ---
# KNOWLEDGE_DIR             каталог с документами        (по умолчанию knowledge)
# KNOWLEDGE_CHUNK_SIZE      размер фрагмента             (по умолчанию 1000)
# KNOWLEDGE_CHUNK_OVERLAP   перекрытие, меньше размера   (по умолчанию 200)
# KNOWLEDGE_TOP_K           число фрагментов в выдаче    (по умолчанию 5)
